# ==============================
# 浙江大学图书馆预约工具 - 配置
# ==============================

# 浙大统一身份认证账号（学号）
ZJU_USERNAME="3230100000"

# 浙大统一身份认证密码
ZJU_PASSWORD="你的密码"

# 钉钉机器人通知（可选）
# 如果想收到钉钉通知，就填下面两个。不填也能用，只是没通知
# 钉钉群机器人 Webhook 地址
DINGTALK_WEBHOOK="https://oapi.dingtalk.com/robot/send?access_token=你的token"
# 钉钉群机器人加签密钥（SEC开头的那串）
DINGTALK_SECRET="SEC你的密钥"
